# ============================================================
# Pakistan AI - Universal AI Provider Configuration
# ============================================================
# Choose ONE active provider. The rest of the application does not change.
# Presets included: gemini, openrouter, groq, xai, grok, bazaarlink,
# openai, deepseek, together, mistral, anthropic, claude, ollama, custom.
#
# For any OpenAI-compatible service not listed above, use:
#   AI_PROVIDER=custom
#   AI_API_STYLE=openai
#   AI_BASE_URL=https://provider.example/v1
#   AI_MODEL=provider-model-name
#
# Never expose AI_API_KEY in frontend JavaScript or commit .env to Git.

AI_PROVIDER=gemini
AI_API_KEY=PASTE_YOUR_API_KEY_HERE
AI_MODEL=gemini-2.5-flash

# Usually leave these on auto/blank when using a named provider preset.
AI_API_STYLE=auto
AI_BASE_URL=
AI_AUTH_MODE=auto
AI_CHAT_PATH=

# Optional custom headers/query parameters as JSON objects.
# Useful for providers that require an extra project/header or api-version.
AI_EXTRA_HEADERS_JSON={}
AI_QUERY_PARAMS_JSON={}

AI_TIMEOUT_SECONDS=45
AI_TEMPERATURE=0.25
AI_MAX_TOKENS=1100
AI_MAX_TOKENS_FIELD=max_tokens
AI_SEND_TEMPERATURE=true
AI_EXTRA_BODY_JSON={}

# BazaarLink only: prevent paid fallback when using its free route.
DISABLE_PAID_FALLBACK=true

# Local app-side limits. Set MAX_DAILY_LLM_REQUESTS=0 to disable the daily cap.
MAX_DAILY_LLM_REQUESTS=45
MAX_REQUESTS_PER_MINUTE_PER_IP=8

# Retrieval settings.
WIKIPEDIA_RESULTS=3
WIKIPEDIA_CHARS_PER_PAGE=3200

# Local frontend origins.
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
